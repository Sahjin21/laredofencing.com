---
import BaseLayout from "../layouts/BaseLayout.astro";
import FullBleedBand from "../components/FullBleedBand.astro";
import { siteConfig } from "../lib/config";

const description = `${siteConfig.businessName} is the Laredo-area fence installation outfit. Wood privacy, chain-link, ornamental iron, and ranch fencing across ${siteConfig.geo} and Webb County.`;
---

<BaseLayout title={`About | ${siteConfig.businessName}`} description={description}>
  <section class="border-b border-slate-200 bg-slate-950 py-20 text-white sm:py-28">
    <div class="container-shell grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-sm font-black tracking-[0.14em] text-amber-300 uppercase">About this site</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-black leading-tight sm:text-6xl">Laredo fence installation, the way South Texas clay actually moves.</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
          {siteConfig.businessName} is the Laredo-area fence installation outfit built around how the ground works here. We set every post in concrete below Laredo's alkaline-clay layer, brace every corner, walk the line with you at completion, and put every quote in writing before the first hole is dug.
        </p>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
          Wood privacy, chain-link, ornamental iron, and ranch fencing across Laredo and Webb County. We work the southside subdivisions, the Mines Road ranch belt, and the lots that don't quite fit a standard plan.
        </p>
      </div>
      <aside class="grid gap-4 rounded-3xl border border-white/10 bg-white/[0.04] p-8 text-sm text-slate-300 backdrop-blur">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-amber-300">Service area</p>
          <p class="mt-1 text-xl font-black text-white">Laredo, TX · Webb County</p>
          <p class="mt-1 text-slate-400">Rio Grande Valley · Zapata County</p>
        </div>
        <hr class="border-white/10"/>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-amber-300">Office</p>
          <p class="mt-1 text-white">{siteConfig.phone}</p>
          <p class="mt-1 text-slate-400">A real Laredo resident answers. No phone tree.</p>
        </div>
        <hr class="border-white/10"/>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-amber-300">Quote turnaround</p>
          <p class="mt-1 text-xl font-black text-white">Within one business day</p>
          <p class="mt-1 text-slate-400">Most Laredo residential jobs quoted same week.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white py-20 sm:py-28">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">What we focus on</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Four things that decide whether a Laredo fence lasts.</h2>
      </div>
      <ol class="stand-list mt-12">
        <li class="stand-item">
          <span class="stand-num">01</span>
          <div>
            <h3 class="stand-title">Posts set below the active clay layer</h3>
            <p class="stand-body">Laredo's alkaline clay moves with seasonal moisture. We set every post 24 to 30 inches deep — below the layer that swells and shrinks — so the line stays straight through South Texas summers.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">02</span>
          <div>
            <h3 class="stand-title">Brace assembly at every corner and gate</h3>
            <p class="stand-body">Without a proper brace assembly, a single South Texas storm pulls a corner apart and the whole line follows. We build them properly the first time.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">03</span>
          <div>
            <h3 class="stand-title">Walk the line with you at completion</h3>
            <p class="stand-body">At completion we walk the fence with you, confirm gate swing and latch function, and clean the site. Leftover concrete and sawdust leave with the crew.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">04</span>
          <div>
            <h3 class="stand-title">Written estimate before any work starts</h3>
            <p class="stand-body">Every quote is written, signed, and dated with line-item pricing. No verbal numbers, no surprises on the day the crew shows up.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <FullBleedBand tone="tint">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">How we work</p>
      <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Three steps from first call to finished fence.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-base font-black">1. Walk the property</p>
          <p class="mt-3 text-sm leading-6 text-slate-600">We come out, mark the fence line with you, confirm height and style, flag anything underground (irrigation, gas, low-voltage lighting), and put the quote in writing.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-base font-black">2. Written quote</p>
          <p class="mt-3 text-sm leading-6 text-slate-600">You get a line-item quote with post spacing, concrete depth, and the style spelled out. Most Laredo residential jobs quoted same week.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-base font-black">3. Build day</p>
          <p class="mt-3 text-sm leading-6 text-slate-600">Most residential jobs run 2-4 days on site. We schedule a build date once you sign off on the written quote — typical lead time is 1-2 weeks.</p>
        </div>
      </div>
    </div>
  </FullBleedBand>

  <section class="bg-white py-20 sm:py-28">
    <div class="container-shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Talk with us</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Call and describe your property.</h2>
        <p class="mt-6 leading-7 text-slate-600">
          Address, fence type, approximate linear feet, anything underground, HOA or subdivision overlay, and the best way to reach you. We'll come back with a written quote within one business day.
        </p>
        <a class="button-primary mt-8" href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`} data-lead-call>
          Call {siteConfig.phone}
        </a>
      </div>
      <div>
        <p class="eyebrow">Office</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">A real Laredo resident answers.</h2>
        <p class="mt-6 leading-7 text-slate-600">
          No phone tree, no answering service. The same Laredo-based office that schedules your walk-through is the one that sends the crew on build day. Office line: <a class="font-bold text-teal-700 no-underline hover:text-teal-800" href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`}>{siteConfig.phone}</a>.
        </p>
        <p class="mt-6 leading-7 text-slate-600">
          Operating hours: Mon-Sat, 7am-7pm. We pull property questions, set a walk-through appointment, and get you a written quote.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The "stand on" / "What we focus on" list — clean numbered list,
     no rounded bordered containers. */
  .stand-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }
  .stand-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 22px;
    padding: 22px 0;
    border-top: 1px solid #e2e8f0;
  }
  .stand-item:first-child { border-top: none; padding-top: 0; }
  .stand-num {
    font-family: ui-serif, Georgia, serif;
    font-size: 32px;
    line-height: 1;
    font-weight: 900;
    color: #0f766e;
    letter-spacing: -0.02em;
  }
  .stand-title {
    margin: 2px 0 6px;
    font-size: 18px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.005em;
  }
  .stand-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: #475569;
  }
  @media (max-width: 640px) {
    .stand-item { grid-template-columns: 48px 1fr; gap: 16px; padding: 18px 0; }
    .stand-num { font-size: 24px; }
  }
</style>