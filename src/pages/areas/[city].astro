---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { effectiveContact, siteConfig } from "../../lib/config";

export async function getStaticPaths() {
  return siteConfig.areaCities.map((city) => ({
    params: { city: city.slug },
  }));
}

const { city: citySlug } = Astro.params;
const city = siteConfig.areaCities.find((c) => c.slug === citySlug);

if (!city) {
  return Astro.redirect("/areas/");
}

const description = `Laredo fence installation in ${city.name}, ${city.state}. ${city.brief}`;
---

<BaseLayout
  title={`${city.name}, ${city.state} fence installation | ${siteConfig.businessName}`}
  description={description}
>
  <section class="border-b border-slate-200 bg-slate-950 py-20 text-white sm:py-28">
    <div class="container-shell">
      <nav class="text-xs text-slate-400" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a class="no-underline hover:text-amber-300" href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="no-underline hover:text-amber-300" href="/areas/">Areas</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-amber-300">{city.name}, {city.state}</li>
        </ol>
      </nav>
      <h1 class="mt-5 max-w-3xl text-4xl font-black leading-tight sm:text-6xl">Fence installation in {city.name}, {city.state}</h1>
      {city.population && (
        <p class="mt-3 text-sm font-bold uppercase tracking-wider text-amber-300">{city.population}</p>
      )}
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">{city.brief}</p>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white py-20 sm:py-28">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">What we install here</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Fence work we do in {city.name}</h2>
      </div>
      <ol class="stand-list mt-12">
        <li class="stand-item">
          <span class="stand-num">01</span>
          <div>
            <h3 class="stand-title">Wood privacy fence</h3>
            <p class="stand-body">Cedar and pressure-treated pine, 6 and 8 foot heights, board-on-board or side-by-side pickets. Posts set in concrete below {city.name}'s active clay layer.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">02</span>
          <div>
            <h3 class="stand-title">Chain-link fence</h3>
            <p class="stand-body">Galvanized and vinyl-coated chain-link for residential yards, dog runs, commercial lots, and construction sites.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">03</span>
          <div>
            <h3 class="stand-title">Wrought iron and ornamental</h3>
            <p class="stand-body">Ornamental iron for front yards, pool enclosures, and subdivision view-keepers that need a decorative boundary.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">04</span>
          <div>
            <h3 class="stand-title">Ranch and livestock fence</h3>
            <p class="stand-body">Barbed wire, field fence, pipe-and-cable, and game fence for acreage and rural properties around {city.name}.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {(city.neighborhoods && city.neighborhoods.length > 0) && (
    <section class="border-b border-slate-200 bg-slate-100 py-20 sm:py-28">
      <div class="container-shell">
        <p class="eyebrow">Where we work</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Subdivisions and lots we know in {city.name}</h2>
        <p class="mt-6 max-w-3xl leading-7 text-slate-600">We've built fences across these {city.name} neighborhoods. If yours isn't on the list, ask — most operators will travel within ~25 miles.</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {city.neighborhoods.map((n) => (
            <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-700">
              <Icon name="map-pin" class="h-4 w-4 text-teal-600" />{n}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {(city.primaryAreaLabels && city.primaryAreaLabels.length > 0) && (
    <section class="border-b border-slate-200 bg-white py-20 sm:py-28">
      <div class="container-shell">
        <p class="eyebrow">Other ways folks find us</p>
        <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Search terms for {city.name} fence work</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {city.primaryAreaLabels.map((label) => (
            <li class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-base font-bold text-slate-700">{label}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bg-slate-900 py-20 text-white sm:py-28">
    <div class="container-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow !text-amber-300">Talk with us</p>
        <h2 class="mt-3 text-3xl font-black sm:text-4xl">Call us about your fence in {city.name}</h2>
        <p class="mt-6 text-lg leading-8 text-slate-300">Address, fence type, approximate linear feet, anything underground — we come back with a written quote within one business day.</p>
        <a
          class="button-primary mt-8 inline-flex"
          href={`tel:${effectiveContact.phoneHref.replace(/[^+\d]/g, "")}`}
          data-lead-call
          aria-label={`Call ${siteConfig.businessName} at ${effectiveContact.phone}`}
        >
          Call {effectiveContact.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stand-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }
  .stand-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 22px;
    padding: 22px 0;
    border-top: 1px solid #e2e8f0;
  }
  .stand-item:first-child { border-top: none; padding-top: 0; }
  .stand-num {
    font-family: ui-serif, Georgia, serif;
    font-size: 32px;
    line-height: 1;
    font-weight: 900;
    color: #0f766e;
    letter-spacing: -0.02em;
  }
  .stand-title {
    margin: 2px 0 6px;
    font-size: 18px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.005em;
  }
  .stand-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: #475569;
  }
  @media (max-width: 640px) {
    .stand-item { grid-template-columns: 48px 1fr; gap: 16px; padding: 18px 0; }
    .stand-num { font-size: 24px; }
  }
</style>