---
import AngledDivider from "../components/AngledDivider.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { effectiveContact, pageTitle, siteConfig } from "../lib/config";

const description = `${siteConfig.businessName} — Laredo-area fence installation. Wood privacy, chain-link, ornamental iron, and ranch fencing for homes, businesses, and acreage across Webb County.`;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: siteConfig.faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title={pageTitle()} description={description} schemas={[faqSchema]}>
  <!--
    Hero — single brand, single phone, single CTA. Energy Fencing / Nationwide
    / American Fence Co pattern. No provider list, no directory panel.
    The cycle for "who picks up" lives server-side in the lead router.
  -->
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img
        src="/images/laredo-home-hero.webp"
        alt=""
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover opacity-60"
        style="background: linear-gradient(120deg, #1f2937 0%, #0b1320 100%);"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(6,18,28,0.85) 0%, rgba(6,18,28,0.35) 60%, rgba(6,18,28,0.75) 100%);"></div>
    </div>
    <div class="container-shell relative z-10 grid items-end gap-12 py-20 sm:py-28 lg:grid-cols-[1.25fr_0.85fr]">
      <div>
        <p class="text-sm font-black tracking-[0.18em] text-amber-300 uppercase">{siteConfig.businessName} · {siteConfig.geo}</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-black uppercase leading-[1.05] sm:text-6xl">
          Fence installation<br />that holds through<br />South Texas weather.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-200 sm:text-lg sm:leading-9">
          Wood privacy, chain-link, ornamental iron, and ranch fencing across Laredo and Webb County. Posts set below the clay layer, line walked with you at completion, every job signed off in writing.
        </p>
        <a class="mt-10 inline-flex min-h-12 items-center text-sm font-bold uppercase tracking-[0.18em] text-amber-300 no-underline hover:text-amber-200" href="#services">
          See the work <span class="ml-2" aria-hidden="true">↓</span>
        </a>
      </div>

      <aside class="rounded-2xl border border-white/15 bg-white/[0.06] p-6 backdrop-blur">
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-amber-300">Talk with us</p>
        <a
          href={`tel:${effectiveContact.phoneHref.replace(/[^+\d]/g, "")}`}
          class="mt-3 block text-3xl font-black tracking-tight tabular-nums text-white no-underline hover:text-amber-200 sm:text-4xl"
          data-lead-call
          aria-label={`Call ${siteConfig.businessName} at ${effectiveContact.phone}`}
        >
          {effectiveContact.phone}
        </a>
        <p class="mt-2 text-sm leading-5 text-slate-300">A real Laredo resident answers. No phone tree.</p>
      </aside>
    </div>
  </section>

  <!--
    Service scrollytelling panels — full-bleed sticky-stack.
    Pattern reference:
      https://lightweavershealing.com  .transition-section (height: 100vh,
        background-attachment: fixed, background-size: cover, text overlay top: 40%)
      https://willyoubeattending.com  .parallax-panel (position: sticky; top: 0;
        min-height: 100svh; z-index-driven stacking)

    Each service is one section with position: sticky + top: 0 so they
    visually stack as you scroll, each new section rising over the previous.
    Full-bleed photo (laredo-*-hero.webp, NOT the card variant), dark
    vignette, sparkles icon top-left, sticky text overlay bottom-left,
    alternating right-aligned on even panels.
  -->
  <AngledDivider color="#f8fafc" />

  <section id="services" class="services-stack bg-slate-50 pt-20 sm:pt-28">
    <header class="container-shell max-w-3xl pb-10 sm:pb-14">
      <p class="eyebrow">Services</p>
      <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">Built for every Laredo property</h2>
      <p class="mt-6 leading-8 text-slate-600">
        From backyard privacy to ranch-line pasture fence. Scroll through to see what we build for each property type, what affects the price, and what to expect on the install.
      </p>
    </header>
    <div class="services-stack-rail">
      {siteConfig.services.map((service, idx, arr) => {
        const heroTile = service.image.replace('-hero-card.webp', '-hero.webp');
        const isLast = idx === arr.length - 1;
        return (
          <>
            <ServiceCard
              service={service}
              index={idx}
              totalSlides={siteConfig.services.length}
              tile={heroTile}
            />
            {!isLast && <div class="slide-spacer" aria-hidden="true"></div>}
          </>
        );
      })}
    </div>
    <div class="container-shell py-16 text-center sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Unusual property?</p>
      <p class="mx-auto mt-3 max-w-md text-base leading-7 text-slate-500">Acreage, custom gates, or a non-standard lot — call and we'll tell you whether we're a fit.</p>
    </div>
  </section>

  <!--
    "Why us" — six reasons frame, like Energy Fencing. Three concrete claims,
    each with its own heading, body, and visible detail. No directory features.
  -->
  <section id="about" class="bg-white py-20 sm:py-28">
    <div class="container-shell grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <header>
        <p class="eyebrow">About us</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">What we stand on</h2>
        <p class="mt-6 max-w-xl leading-8 text-slate-600">
          Laredo fence installation run by people who grew up here. We know what holds in alkaline clay and what's worth paying for.
        </p>
      </header>
      <ol class="stand-list">
        <li class="stand-item">
          <span class="stand-num">01</span>
          <div>
            <h3 class="stand-title">Set posts below the clay</h3>
            <p class="stand-body">Laredo's alkaline clay has an active root zone 18 to 24 inches deep. We set every post to 24 to 30 inches in concrete — below the layer that moves with seasonal moisture.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">02</span>
          <div>
            <h3 class="stand-title">Brace every corner and gate</h3>
            <p class="stand-body">A brace assembly at every corner and gate. Without these, a single South Texas storm pulls the line apart. We build them properly the first time.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">03</span>
          <div>
            <h3 class="stand-title">Walk the line with you</h3>
            <p class="stand-body">At completion, we walk the fence with you, confirm gate swing and latch, and clean the site. Leftover concrete and sawdust leave with the crew.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">04</span>
          <div>
            <h3 class="stand-title">Permit paperwork handled</h3>
            <p class="stand-body">When a City of Laredo permit is required (some subdivision overlays require them), we coordinate the permit paperwork and pass the inspection on your behalf.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <style>
    .stand-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0;
    }
    .stand-item {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 22px;
      padding: 22px 0;
      border-top: 1px solid #e2e8f0;
    }
    .stand-item:first-child { border-top: none; padding-top: 0; }
    .stand-num {
      font-family: ui-serif, Georgia, serif;
      font-size: 32px;
      line-height: 1;
      font-weight: 900;
      color: #0f766e;
      letter-spacing: -0.02em;
    }
    .stand-title {
      margin: 2px 0 6px;
      font-size: 18px;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: -0.005em;
    }
    .stand-body {
      margin: 0;
      font-size: 15px;
      line-height: 1.7;
      color: #475569;
    }
    @media (max-width: 640px) {
      .stand-item { grid-template-columns: 48px 1fr; gap: 16px; padding: 18px 0; }
      .stand-num { font-size: 24px; }
    }
  </style>

  <!--
    Trust band removed per operator (2026-07-31): copy here was framing
    the site as a directory ("We list Laredo fence contractors. You
    pick who calls you back..."), but the operator wants the site
    presented as THE contractor, not a directory. With the
    directory disclosure out, there's no trust band in this section.
    If the operator wants trust copy restored later, it should be
    first-person-contractor voice, not directory-disclosure voice.
  -->

  <!--
    Process — keeps the original 3-step, but in Energy Fencing format.
  -->
  <section class="bg-white py-20 sm:py-28">
    <div class="container-shell">
      <header class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Our process</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">How we work</h2>
      </header>
      <ol class="stand-list mt-14 mx-auto max-w-3xl">
        <li class="stand-item">
          <span class="stand-num">01</span>
          <div>
            <h3 class="stand-title">Get a free estimate</h3>
            <p class="stand-body">Call us or send the form below. We ask for the address, what you're fencing, and a short description of the property so we can put a real number on the quote.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">02</span>
          <div>
            <h3 class="stand-title">Walk the property together</h3>
            <p class="stand-body">We walk the line, confirm the height and style, flag anything underground, and put the quote in writing with line-item pricing.</p>
          </div>
        </li>
        <li class="stand-item">
          <span class="stand-num">03</span>
          <div>
            <h3 class="stand-title">Schedule the build</h3>
            <p class="stand-body">Most residential jobs run 2–4 days on site. We schedule a build date once you sign off on the written quote — typical lead time is 1–2 weeks.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!--
    FAQ — kept short. Real Laredo questions. Energy Fencing format.
  -->
  <section id="faq" class="border-y border-slate-200 bg-slate-50 py-20 sm:py-28">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <header>
        <p class="eyebrow">Common questions</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-4xl">Before you schedule</h2>
        <p class="mt-5 leading-8 text-slate-600">These are a few questions Laredo homeowners ask most. Call us directly if your situation is different.</p>
      </header>
      <FAQ items={siteConfig.faqs} />
    </div>
  </section>

  <!--
    Final CTA — single phone, single form, no provider list.
  -->
  <section id="contact" class="bg-slate-900 py-20 text-white sm:py-28">
    <div class="container-shell grid items-start gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="eyebrow !text-amber-300">Get a free quote</p>
        <h2 class="mt-3 text-3xl font-black uppercase sm:text-5xl">Tell us what you need.</h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Send a short description of the work, your property address, and the best way to reach you. We'll come back with a written quote within one business day.</p>
        <p class="mt-6 text-sm text-slate-400">
          Or call <a href={`tel:${effectiveContact.phoneHref.replace(/[^+\d]/g, "")}`} class="font-bold text-amber-300 no-underline hover:text-amber-200" data-lead-call>{effectiveContact.phone}</a> — a real Laredo resident answers.
        </p>
        <p class="mt-3 text-xs text-slate-500">
          No down payment to schedule. Most Laredo residential jobs quoted same week.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
