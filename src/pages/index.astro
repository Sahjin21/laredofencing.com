---
import AngledDivider from "../components/AngledDivider.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle, siteConfig } from "../lib/config";

const description = `${siteConfig.businessName} — Laredo-area fence installation. Wood privacy, chain-link, ornamental iron, and ranch fencing for homes, businesses, and acreage across Webb County.`;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: siteConfig.faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title={pageTitle()} description={description} schemas={[faqSchema]}>
  <!--
    Hero — single brand, single phone, single CTA. Energy Fencing / Nationwide
    / American Fence Co pattern. No provider list, no directory panel.
    The cycle for "who picks up" lives server-side in the lead router.
  -->
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img
        src="/images/laredo-home-hero.webp"
        alt=""
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover opacity-60"
        style="background: linear-gradient(120deg, #1f2937 0%, #0b1320 100%);"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(6,18,28,0.85) 0%, rgba(6,18,28,0.35) 60%, rgba(6,18,28,0.75) 100%);"></div>
    </div>
    <div class="container-shell relative z-10 grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.25fr_0.85fr]">
      <div>
        <p class="text-sm font-black tracking-[0.18em] text-amber-300 uppercase">{siteConfig.businessName} · {siteConfig.geo}</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-black uppercase leading-[1.05] sm:text-6xl">
          Fence installation<br />that holds through<br />South Texas weather.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-200 sm:text-lg sm:leading-9">
          Wood privacy, chain-link, ornamental iron, and ranch fencing across Laredo and Webb County. Posts set below the clay layer, line walked with you at completion, every job signed off in writing.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a class="button-primary px-8 text-base" href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`} data-lead-call>Call us</a>
          <a class="inline-flex min-h-14 items-center rounded-xl border-2 border-amber-300 bg-transparent px-7 font-bold text-amber-300 no-underline hover:bg-amber-300 hover:text-slate-950" href="#contact">Get a free quote</a>
        </div>
        <p class="mt-5 text-sm text-slate-400">{siteConfig.responseTime} response · Free written estimate for most residential jobs · No down payment to schedule.</p>
      </div>

      <aside class="rounded-3xl border border-white/15 bg-white/[0.06] p-7 backdrop-blur">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-300">Call our office</p>
        <p class="mt-4 text-4xl font-black tracking-tight tabular-nums">{siteConfig.phone}</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">
          A real Laredo resident answers. We pull property questions, set a walk-through appointment, and get you a written quote.
        </p>
        <hr class="my-6 border-white/15"/>
        <ul class="space-y-3 text-sm text-slate-200">
          <li class="flex items-start gap-3">
            <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-amber-300" />
            <span><strong class="block">Texas-licensed, fully insured</strong> Worker's comp and general liability on every job.</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-amber-300" />
            <span><strong class="block">Free, no-pressure written estimates</strong> Most Laredo residential jobs quoted same week.</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-amber-300" />
            <span><strong class="block">Permits and HOA paperwork handled</strong> We pull City of Laredo permits and prepare HOA packages.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <!--
    Service sections — like Energy Fencing. Each service is its own full-width
    section with a photo header, title, and the call.
  -->
  <AngledDivider color="#f8fafc" />

  <section id="services" class="bg-slate-50 py-20 sm:py-28">
    <div class="container-shell">
      <header class="max-w-3xl">
        <p class="eyebrow">Services</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">Built for every Laredo property</h2>
        <p class="mt-6 leading-8 text-slate-600">
          From backyard privacy to ranch-line pasture fence. Each section below describes what we build, what affects your price, and what to expect on the install.
        </p>
      </header>
      <div class="services-rail mt-12" tabindex="0" aria-label="Service cards">
        {siteConfig.services.map((service) => <ServiceCard service={service} />)}
      </div>
      <ol class="services-dots mt-6 flex items-center justify-center gap-2 sm:hidden" aria-hidden="true">
        {siteConfig.services.map((_, idx) => (
          <li class={`services-dot${idx === 0 ? ' services-dot-active' : ''}`}></li>
        ))}
      </ol>
      <p class="mt-6 text-center text-xs font-medium text-slate-400 sm:hidden">Swipe →</p>
    </div>
  </section>

  <style>
    .services-rail {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 24px;
      padding: 16px 24px 16px 4px;
      margin: -16px -24px -16px -4px;
      -webkit-overflow-scrolling: touch;
      scrollbar-color: #cbd5e1 transparent;
      scrollbar-width: thin;
    }
    .services-rail > * {
      scroll-snap-align: start;
    }
    .services-rail::-webkit-scrollbar { height: 8px; }
    .services-rail::-webkit-scrollbar-track { background: transparent; }
    .services-rail::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }
    .services-rail:focus-visible {
      outline: 3px solid #fbbf24;
      outline-offset: 4px;
      border-radius: 4px;
    }
    /* Larger cards on wider screens, plus better snapping at boundaries. */
    @media (min-width: 640px) {
      .services-rail { gap: 32px; padding: 16px 32px 16px 4px; }
    }
    @media (min-width: 1024px) {
      .services-rail { gap: 36px; }
    }
    .services-dots { list-style: none; padding: 0; margin: 0; }
    .services-dot {
      width: 8px; height: 8px; border-radius: 999px;
      background: #cbd5e1;
    }
    .services-dot-active { background: #0f766e; width: 18px; }
  </style>

  <!--
    "Why us" — six reasons frame, like Energy Fencing. Three concrete claims,
    each with its own heading, body, and visible detail. No directory features.
  -->
  <section id="about" class="bg-white py-20 sm:py-28">
    <div class="container-shell grid gap-12 lg:grid-cols-[0.95fr_1.05fr]">
      <header>
        <p class="eyebrow">About us</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">What we stand on</h2>
        <p class="mt-6 max-w-xl leading-8 text-slate-600">
          {siteConfig.businessName} is a {siteConfig.geo} fence-installation outfit run by people who grew up here. We know what holds in alkaline clay, what the wind does to a cheap post-set, and what's worth paying for vs. what we can leave off a quote.
        </p>
        <a class="button-primary mt-8 inline-flex" href="#contact">Get a quote</a>
      </header>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="font-display text-3xl font-black text-teal-700">01</p>
          <h3 class="mt-3 text-lg font-black">Set posts below the clay</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Laredo's alkaline clay has an active root zone 18 to 24 inches deep. We set every post to 24 to 30 inches in concrete — below the layer that moves with seasonal moisture.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="font-display text-3xl font-black text-teal-700">02</p>
          <h3 class="mt-3 text-lg font-black">Brace every corner</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">A brace assembly at every corner and gate — without these, a single South Texas storm pulls the line apart. We build them properly the first time.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="font-display text-3xl font-black text-teal-700">03</p>
          <h3 class="mt-3 text-lg font-black">Walk the line with you</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">At completion, we walk the fence with you, confirm gate swing and latch function, and clean the site — leftover concrete and sawdust leave with the crew.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="font-display text-3xl font-black text-teal-700">04</p>
          <h3 class="mt-3 text-lg font-black">Pull the permits</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">When a City of Laredo permit is required (some subdivision overlays require them), we pull the permit, schedule the inspection, and pass it on your behalf.</p>
        </div>
      </div>
    </div>
  </section>

  <!--
    Trust band — credential row. Texas-licensed, fully insured, written
    quote on every job, City-of-Laredo permit pull included. Placeholder logo
    tiles sit where real trust badges will land (BBB, AFA, etc.) once verified.
  -->
  <section class="bg-slate-100 py-20 sm:py-28">
    <div class="container-shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="eyebrow">Credentials &amp; trust</p>
          <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">Texas-licensed. Insured. Quotable.</h2>
          <p class="mt-6 max-w-xl leading-8 text-slate-600">We carry Texas general liability and workers' comp on every job. Every quote is written, signed, and dated. Nothing subcontracted without your written approval.</p>
          <ul class="mt-6 grid grid-cols-1 gap-3 text-sm">
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-teal-700"/><span>Texas general contractor registration, current and verifiable</span></li>
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-teal-700"/><span>Workers' compensation + commercial general liability — certificate provided on request</span></li>
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-teal-700"/><span>Written estimate with line-item pricing before any work starts</span></li>
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-teal-700"/><span>City of Laredo permits pulled in our name where required</span></li>
          </ul>
          <p class="mt-6 text-xs text-slate-500">Specific license numbers and BBB / AFA / trade-membership credential tiles are added once each is publicly verified. <a class="font-bold underline" href="/about/">See the verification process on the About page</a>.</p>
        </div>
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">Texas<br/>Licensed</li>
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">Insured<br/>$1M+ Liab.</li>
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">BBB A+<br/><span class="text-[10px] text-slate-400">pending</span></li>
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">AFA<br/>Member<br/><span class="text-[10px] text-slate-400">pending</span></li>
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">Webb Co.<br/>Served</li>
          <li class="grid h-24 place-items-center rounded-2xl border border-slate-200 bg-white p-4 text-center font-display text-xs font-black uppercase tracking-wider text-slate-400">Free<br/>Quotes</li>
        </ul>
      </div>
    </div>
  </section>

  <!--
    Process — keeps the original 3-step, but in Energy Fencing format.
  -->
  <section class="bg-white py-20 sm:py-28">
    <div class="container-shell">
      <header class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Our process</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-5xl">How we work</h2>
      </header>
      <ol class="mt-14 grid gap-8 md:grid-cols-3">
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-teal-700 text-xl font-black text-white">01</span>
          <h3 class="mt-4 text-xl font-black">Get a free estimate</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Call us or send the form below. We ask for the address, what you're fencing, and a short description of the property so we can put a real number on the quote.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-teal-700 text-xl font-black text-white">02</span>
          <h3 class="mt-4 text-xl font-black">Walk the property together</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">We walk the line, confirm the height and style, flag anything underground, and put the quote in writing with line-item pricing.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-teal-700 text-xl font-black text-white">03</span>
          <h3 class="mt-4 text-xl font-black">Schedule the build</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Most residential jobs run 2–4 days on site. We schedule a build date once you sign off on the written quote — typical lead time is 1–2 weeks.</p>
        </li>
      </ol>
    </div>
  </section>

  <!--
    FAQ — kept short. Real Laredo questions. Energy Fencing format.
  -->
  <section id="faq" class="border-y border-slate-200 bg-slate-50 py-20 sm:py-28">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <header>
        <p class="eyebrow">Common questions</p>
        <h2 class="mt-3 text-3xl font-black uppercase text-slate-950 sm:text-4xl">Before you schedule</h2>
        <p class="mt-5 leading-8 text-slate-600">These are a few questions Laredo homeowners ask most. Call us directly if your situation is different.</p>
      </header>
      <FAQ items={siteConfig.faqs} />
    </div>
  </section>

  <!--
    Final CTA — single CTA, single phone, no provider list.
  -->
  <section id="contact" class="bg-slate-900 py-20 text-white sm:py-28">
    <div class="container-shell grid items-start gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="eyebrow !text-amber-300">Get a free quote</p>
        <h2 class="mt-3 text-3xl font-black uppercase sm:text-5xl">Tell us what you need.</h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Send a short description of the work, your property address, and the best way to reach you. We'll come back with a written quote within one business day.</p>
        <a class="mt-8 inline-flex min-h-14 items-center rounded-xl bg-amber-400 px-7 font-black text-slate-950 no-underline hover:bg-amber-300" href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`} data-lead-call>Call {siteConfig.phone}</a>
        <p class="mt-6 text-sm text-slate-400">
          No down payment to schedule. Most Laredo residential jobs quoted same week. Have an HOA or permit requirement? Tell us — we handle both.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
