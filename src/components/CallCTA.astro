---
// Single-brand CTA. Visitors see one fence-contractor brand (Laredo Fence
// Pros), one phone, one form. The fan-out routing happens server-side in
// the dashboard; visitor-side this is presented as a single contractor.
import { siteConfig } from "../lib/config";
interface Props {
  heading?: string;
  description?: string;
  referringService?: string;
}
const { heading = `Talk with us about your project`, description = "We'll come back with a written quote within one business day. No down payment to schedule." } = Astro.props;
---

<section id="contact" class="cta-band relative overflow-hidden py-20 text-white sm:py-28">
  <div class="cta-band-bg absolute inset-0" aria-hidden="true">
    <img src="/images/laredo-trust-band.webp" alt="" width="1600" height="900" loading="lazy" class="h-full w-full object-cover opacity-50"/>
    <div class="cta-band-overlay absolute inset-0" style="background: linear-gradient(180deg, rgba(15,118,110,0.92) 0%, rgba(6,78,73,0.97) 100%);"></div>
  </div>
  <div class="container-shell relative z-10 grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="text-sm font-bold tracking-[0.08em] text-amber-300 uppercase">Talk with a local professional</p>
      <h2 class="mt-3 text-3xl font-black sm:text-5xl">{heading}</h2>
      <p class="mt-4 max-w-xl text-lg leading-8 text-teal-50">{description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a class="inline-flex min-h-14 items-center rounded-xl bg-amber-400 px-7 font-black text-slate-950 no-underline hover:bg-amber-300" href={siteConfig.phoneHref} data-lead-call data-business={siteConfig.businessName}>
          Call {siteConfig.phone}
        </a>
        <span class="text-sm text-teal-100">A real Laredo resident answers. No phone tree.</span>
      </div>
      <p class="mt-8 max-w-md text-sm leading-6 text-teal-100/80">Free written quotes · No down payment to schedule · Most Laredo residential jobs quoted same week.</p>
    </div>
    <form class="rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-white/20 sm:p-8" action={`${siteConfig.leadTrackerUrl}/api/v1/leads/events`} method="post" data-lead-form>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-700">Request service</p>
      <h3 class="mt-2 text-xl font-black text-slate-950">Send the request — we'll handle the rest.</h3>
      <input type="hidden" name="form_kind" value="service_followup" />
      <input type="hidden" name="referring_service" value={Astro.props.referringService ?? ""} />
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <label class="block text-sm font-bold text-slate-700 sm:col-span-1"><span class="block">Name</span><input name="name" required class="mt-1 h-12 w-full rounded-lg border border-slate-300 px-4 font-normal text-slate-950 outline-none focus:border-teal-600" placeholder="Jane D." /></label>
        <label class="block text-sm font-bold text-slate-700 sm:col-span-1"><span class="block">Phone</span><input name="phone" type="tel" autocomplete="tel" required class="mt-1 h-12 w-full rounded-lg border border-slate-300 px-4 font-normal text-slate-950 outline-none focus:border-teal-600" placeholder="(956) 555-0123" /></label>
        <label class="block text-sm font-bold text-slate-700 sm:col-span-2"><span class="block">Email <span class="font-normal text-slate-500">(optional)</span></span><input name="email" type="email" class="mt-1 h-12 w-full rounded-lg border border-slate-300 px-4 font-normal text-slate-950 outline-none focus:border-teal-600" placeholder="you@example.com" /></label>
        <label class="block text-sm font-bold text-slate-700 sm:col-span-2"><span class="block">Tell us what you need</span><textarea name="message" rows="3" maxlength="500" class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-3 font-normal text-slate-950 outline-none focus:border-teal-600" placeholder="Address, fence type, approximate linear feet, anything we should know."></textarea></label>
      </div>
      <button type="submit" class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-teal-700 px-6 font-black text-white no-underline hover:bg-teal-600">Send my request</button>
      <p class="mt-3 text-xs text-slate-500">By sending this request you agree to be contacted about your fence project. See our <a class="underline" href="/privacy/">privacy policy</a>.</p>
    </form>
  </div>
</section>

<style>
.cta-band { background: #0a5651; }
.cta-band-bg img { transition: transform 800ms cubic-bezier(.2,.7,.3,1); }
.cta-band:hover .cta-band-bg img { transform: scale(1.04); }
.cta-band :where(input, textarea) { transition: border-color 200ms; }
.cta-band :where(input, textarea):focus { border-color: #0f766e; }
</style>
