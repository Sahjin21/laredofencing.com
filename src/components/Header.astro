---
import { siteConfig } from "../lib/config";

// Header — single row. Logo left, modern square nav chips centered, phone
// as a quiet inline link on the right.
//
// Nav pattern (per operator): "professional modern elements ... square
// and theme colored."
// Each nav item is a rounded-square chip with the theme teal accent on
// the leading edge. On hover: tinted square fills; on the active page:
// outlined square + amber accent dot.
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/95 backdrop-blur">
  <div class="container-shell flex h-16 items-center justify-between gap-4 md:h-20 md:gap-6">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-black leading-tight text-slate-950 no-underline" aria-label={`${siteConfig.businessName} — home`}>
      <span class="grid h-10 w-10 place-items-center rounded-md bg-teal-700 text-white md:h-11 md:w-11">
        <span class="font-mono text-base font-black tracking-tighter" aria-hidden="true">LF</span>
      </span>
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="text-base font-black uppercase">{siteConfig.businessName}</span>
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Fence installation · {siteConfig.geo}</span>
      </span>
      <span class="font-black sm:hidden">{siteConfig.businessName}</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center md:flex">
      <a href="/#services" class="nav-chip"><span class="nav-chip-mark" aria-hidden="true"></span>Services</a>
      <a href="/areas/" class="nav-chip"><span class="nav-chip-mark" aria-hidden="true"></span>Service Areas</a>
      <a href="/pricing/" class="nav-chip"><span class="nav-chip-mark" aria-hidden="true"></span>Pricing</a>
      <a href="/about/" class="nav-chip"><span class="nav-chip-mark" aria-hidden="true"></span>About</a>
      <a href="/#faq" class="nav-chip"><span class="nav-chip-mark" aria-hidden="true"></span>FAQ</a>
    </nav>

    <a
      href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`}
      class="hidden items-center gap-2 text-sm font-bold text-slate-700 no-underline hover:text-teal-700 md:flex"
      data-lead-call
      aria-label={`Call ${siteConfig.businessName} at ${siteConfig.phone}`}
    >
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Call</span>
      <span class="tabular-nums">{siteConfig.phone}</span>
    </a>
  </div>
</header>

<style>
  /* Modern, square, theme-colored nav chips. */
  .nav-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 18px;
    margin: 0 2px;
    border-radius: 8px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 180ms, color 180ms, transform 180ms;
  }
  .nav-chip-mark {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #cbd5e1;
    transition: background-color 180ms, transform 180ms;
  }
  .nav-chip:hover {
    background-color: #f1f5f9;
    color: #0f766e;
  }
  .nav-chip:hover .nav-chip-mark {
    background: #0f766e;
    transform: rotate(45deg);
  }
  .nav-chip[aria-current="page"] {
    background-color: #ecfdf5;
    color: #064e3b;
  }
  .nav-chip[aria-current="page"] .nav-chip-mark {
    background: #f59e0b;
    transform: rotate(45deg);
  }
</style>

<!-- Mobile sticky CTA — appears after scroll on small screens. -->
<div
  id="mobile-call-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-slate-200 bg-white p-3 shadow-2xl transition-transform md:hidden"
  aria-hidden="true"
>
  <a
    href={`tel:${siteConfig.phoneHref.replace(/[^+\d]/g, "")}`}
    class="button-primary flex min-h-14 w-full items-center justify-center"
    data-lead-call
    aria-label={`Call ${siteConfig.businessName} at ${siteConfig.phone}`}
  >
    Call us · {siteConfig.phone}
  </a>
</div>

<script is:inline>
  var mobileCallBar = document.getElementById("mobile-call-bar");
  function updateMobileCallBar() {
    if (!mobileCallBar) return;
    var visible = window.scrollY > Math.min(window.innerHeight * 0.7, 560);
    mobileCallBar.classList.toggle("translate-y-full", !visible);
    mobileCallBar.setAttribute("aria-hidden", visible ? "false" : "true");
  }
  window.addEventListener("scroll", updateMobileCallBar, { passive: true });
  updateMobileCallBar();
</script>
