---
import { siteConfig } from "../lib/config";

// Header — provider-first phone visibility. Visitors see the listed providers'
// real numbers, not a single brand phone. The sticky mobile bar reveals after
// scroll and links to the providers section on the home page.
const providers = siteConfig.providers;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="border-b border-slate-100 bg-slate-50">
    <div class="container-shell flex min-h-9 flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-slate-600">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="inline-flex items-center gap-1.5 font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Serving {siteConfig.serviceArea.slice(0, 3).join(" · ")}
        </span>
        <span class="hidden text-slate-400 md:inline">|</span>
        <span class="hidden md:inline">{siteConfig.yearsOfOperatorExperience}</span>
      </div>
      <nav aria-label="Quick provider phones" class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Local pros</span>
        {providers.map((provider) => (
          <a
            class="inline-flex items-center gap-1 font-bold text-slate-700 no-underline hover:text-teal-700"
            href={`tel:${provider.phone.replace(/[^+\d]/g, "")}`}
            data-lead-call
            data-business={provider.name}
            aria-label={`Call ${provider.name} at ${provider.phone}`}
          >
            {provider.name.split(" ").slice(-1)[0]}
            <span class="text-slate-400">·</span>
            <span class="tabular-nums">{provider.phone}</span>
          </a>
        )).slice(0, providers.length)}
      </nav>
    </div>
  </div>
  <div class="container-shell flex min-h-20 items-center justify-between gap-4 md:gap-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-black leading-tight text-slate-950 no-underline" aria-label={`${siteConfig.businessName} — home`}>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-teal-700 text-white">
        <span class="font-mono text-sm font-black tracking-tighter" aria-hidden="true">LF</span>
      </span>
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="text-base">{siteConfig.businessName}</span>
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">{siteConfig.geo} · since 1988</span>
      </span>
      <span class="font-black sm:hidden">{siteConfig.businessName}</span>
    </a>
    <nav aria-label="Primary navigation" class="hidden items-center gap-6 md:flex">
      <a href="/#services" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">Services</a>
      <a href="/areas/" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">Service Areas</a>
      <a href="/pricing/" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">Pricing</a>
      <a href="/about/" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">About</a>
      <a href="/#providers" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">Local Pros</a>
      <a href="/#faq" class="text-sm font-bold text-slate-600 no-underline hover:text-teal-700">FAQ</a>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/#providers" class="button-primary whitespace-nowrap">Compare Local Pros</a>
    </div>
  </div>
</header>

<!-- Mobile sticky CTA — appears after scroll on small screens. Routes to the
     providers section on the home page (multi-provider fan-out is the model). -->
<div
  id="mobile-call-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-slate-200 bg-white p-3 shadow-2xl transition-transform md:hidden"
  aria-hidden="true"
>
  <a
    href="/#providers"
    class="button-primary flex min-h-14 w-full items-center justify-center"
    aria-label="Compare local fencing pros"
  >
    Compare {providers.length} local fencing pros
  </a>
</div>

<script is:inline>
  var mobileCallBar = document.getElementById("mobile-call-bar");
  function updateMobileCallBar() {
    if (!mobileCallBar) return;
    var visible = window.scrollY > Math.min(window.innerHeight * 0.7, 560);
    mobileCallBar.classList.toggle("translate-y-full", !visible);
    mobileCallBar.setAttribute("aria-hidden", visible ? "false" : "true");
  }
  window.addEventListener("scroll", updateMobileCallBar, { passive: true });
  updateMobileCallBar();
</script>
