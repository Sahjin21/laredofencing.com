---
// Desktop sticky "Request a quote" rail — appears on the right edge
// after the user scrolls past the hero, hides again over the final
// CTA section (which already has its own CTAs).
//
// Pattern reference: pasadenafoundationrepair.net/StickyCtaRail.astro
// (vertical card, quote icon + label + subtitle, no phone number).
//
// This rail does NOT show a phone number. It scrolls the user to the
// form section. The phone is reachable via:
//   - Header right-side text link
//   - Hero side card (one location on the home page)
//   - Final-CTA inline "Or call xxx" text link
//   - Mobile sticky bottom bar
//   - Footer contact column

const quoteLabel = "Request a quote";
const quoteSubtitle = "Talk to a Laredo fence installer";
const target = "#contact";
---

<aside
  id="sticky-cta-rail"
  class="hidden md:block fixed top-1/2 right-6 -translate-y-1/2 z-20 bg-white shadow-xl border border-slate-200 rounded-2xl p-4 max-w-[220px] opacity-0 pointer-events-none transition-opacity duration-300"
  aria-label="Quick contact"
>
  <a
    href={target}
    class="flex flex-col items-center gap-2 group"
    aria-label={`${quoteLabel} — ${quoteSubtitle}`}
  >
    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2" aria-hidden="true">
      <!-- Clipboard / quote icon -->
      <rect x="6" y="4" width="12" height="16" rx="2" fill="#0f766e" fill-opacity="0.12" stroke-linejoin="round"/>
      <path d="M9 9h6M9 13h6M9 17h4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 4h4a1 1 0 0 1 1 1v1H9V5a1 1 0 0 1 1-1z" fill="#0f766e" fill-opacity="0.18" stroke-linejoin="round"/>
    </svg>
    <span class="font-display text-base font-black text-slate-950 group-hover:text-teal-700 transition-colors text-center">
      {quoteLabel}
    </span>
    <span class="text-xs text-slate-600 text-center leading-snug">{quoteSubtitle}</span>
  </a>
</aside>

<script is:inline>
  (function() {
    function init() {
      var rail = document.getElementById('sticky-cta-rail');
      if (!rail) return;

      var heroEl = document.querySelector('main > section:first-of-type');
      var finalCtaEl = document.getElementById('contact');

      function show() {
        rail.classList.remove('opacity-0', 'pointer-events-none');
        rail.classList.add('opacity-100');
      }
      function hide() {
        rail.classList.remove('opacity-100');
        rail.classList.add('opacity-0', 'pointer-events-none');
      }

      if (!heroEl && !finalCtaEl) {
        // Nothing to anchor against — don't show.
        return;
      }

      function isActive(el) {
        if (!el) return false;
        var rect = el.getBoundingClientRect();
        var vh = window.innerHeight;
        return rect.top < vh - 80 && rect.bottom > 80;
      }

      // Returns true once the hero bottom has crossed 25% of the viewport
      // height — i.e. user has scrolled past it.
      function isPastHero() {
        if (!heroEl) return false;
        var rect = heroEl.getBoundingClientRect();
        return rect.bottom < window.innerHeight * 0.25;
      }

      function update() {
        var scrolled = window.scrollY > 100;
        var pastHero = isPastHero();
        var finalCtaActive = isActive(finalCtaEl);
        if (!scrolled || (!pastHero && isActive(heroEl)) || finalCtaActive) {
          hide();
        } else {
          show();
        }
      }

      var ticking = false;
      function onChange() {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(function() {
            update();
            ticking = false;
          });
        }
      }
      window.addEventListener('scroll', onChange, { passive: true });
      window.addEventListener('resize', onChange);
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>