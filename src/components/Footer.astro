---
import { effectiveContact, siteConfig } from "../lib/config";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 py-16 text-slate-300">
  <div class="container-shell grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-black uppercase text-white">{siteConfig.businessName}</p>
      <p class="mt-3 max-w-xs text-sm leading-7">{siteConfig.businessName} is a Laredo-area fence installation outfit. Wood privacy, chain-link, ornamental iron, and ranch fencing across {siteConfig.geo} and Webb County.</p>
      <p class="mt-5 max-w-xs text-xs leading-5 text-slate-500">Operated by {siteConfig.legalBusinessName}.</p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Services</p>
      <ul class="mt-4 space-y-3 text-sm">
        {siteConfig.services.map((service) => (
          <li>
            <a class="hover:text-white" href={`/services/${service.slug}/`}>{service.name}</a>
          </li>
        ))}
        <li>
          <a class="hover:text-white" href="/pricing/">What affects pricing</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Service areas</p>
      <ul class="mt-4 space-y-3 text-sm">
        {siteConfig.areaCities.map((city) => (
          <li>
            <a class="hover:text-white" href={`/areas/${city.slug}/`}>{city.name}, {city.state}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Contact</p>
      <address class="mt-4 space-y-3 text-sm not-italic">
        <p class="text-white">Call our office</p>
        <p>
          <a class="text-2xl font-black tabular-nums text-amber-300 no-underline hover:text-amber-200" href={`tel:${effectiveContact.phoneHref.replace(/[^+\d]/g, "")}`} data-lead-call>
            {effectiveContact.phone}
          </a>
        </p>
        <p class="text-xs text-slate-400">{siteConfig.responseTime} response · Most Laredo residential quotes same week</p>
        <p class="text-xs text-slate-500 mt-4">Privacy: <a class="font-bold text-amber-300 no-underline hover:text-amber-200" href={`mailto:${siteConfig.operatorPrivacyEmail}`}>{siteConfig.operatorPrivacyEmail}</a></p>
      </address>
      <ul class="mt-6 space-y-2 text-sm">
        <li><a class="hover:text-white" href="/about/">About</a></li>
        <li><a class="hover:text-white" href="/privacy/">Privacy policy</a></li>
        <li><a class="hover:text-white" href="/terms/">Terms of service</a></li>
      </ul>
    </div>
  </div>
  <div class="container-shell mt-12 border-t border-slate-800 pt-6 text-xs leading-5 text-slate-500">
    &copy; {year} {siteConfig.legalBusinessName}, operator of {siteConfig.domain}. All rights reserved.
  </div>
</footer>
