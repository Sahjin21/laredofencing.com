---
import type { Service } from "../lib/config";
import Icon from "./Icon.astro";

interface Props {
  service: Service;
  icon?: string;
}

const { service, icon = "fence" } = Astro.props;
---

<article class="service-slide group">
  <a href={`/services/${service.slug}/`} class="service-slide-link" data-lead-call data-business={service.name} aria-label={`${service.name} — Laredo Fence Pros`}>
    <div class="service-slide-photo">
      <img
        src={service.image}
        alt={`${service.name} in Laredo, Texas`}
        loading="lazy"
        decoding="async"
        class="service-slide-img"
      />
      <div class="service-slide-vignette" aria-hidden="true"></div>
      <div class="service-slide-icon" aria-hidden="true">
        <Icon name={icon} class="h-6 w-6" />
      </div>
      <div class="service-slide-titleplate">
        <h3 class="service-slide-title">{service.name}</h3>
        <p class="service-slide-blurb">{service.shortDescription}</p>
        <span class="service-slide-cta" aria-hidden="true">
          See the work <span class="ml-1">→</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .service-slide {
    position: relative;
    width: 320px;
    height: 460px;
    border-radius: 18px;
    overflow: hidden;
    background: #0f172a;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.06) inset,
      0 24px 50px -28px rgba(15, 23, 42, 0.55);
    transition: transform 350ms cubic-bezier(.2,.7,.3,1), box-shadow 350ms cubic-bezier(.2,.7,.3,1);
    flex-shrink: 0;
  }
  .service-slide:hover {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.08) inset,
      0 36px 70px -28px rgba(15, 23, 42, 0.65);
  }
  .service-slide-link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .service-slide-link:focus-visible {
    outline: 3px solid #fbbf24;
    outline-offset: 4px;
    border-radius: 18px;
  }
  .service-slide-photo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .service-slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(.2,.7,.3,1);
  }
  .service-slide:hover .service-slide-img {
    transform: scale(1.06);
  }
  .service-slide-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(4,23,29,0.55) 65%, rgba(4,23,29,0.92) 100%),
      linear-gradient(0deg, rgba(4,23,29,0) 0%, rgba(4,23,29,0.18) 100%);
    pointer-events: none;
  }
  .service-slide-icon {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.94);
    color: #0f766e;
    box-shadow: 0 8px 22px -10px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }
  .service-slide-titleplate {
    position: absolute;
    inset: auto 0 0 0;
    padding: 22px 22px 22px;
    color: #fef3c7;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }
  .service-slide-title {
    font-family: var(--font-display, ui-serif, Georgia, serif);
    margin: 0;
    color: #ffffff;
    font-size: 22px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .service-slide-blurb {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(254, 243, 199, 0.86);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .service-slide-cta {
    margin-top: 4px;
    color: #fbbf24;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    align-self: flex-start;
  }
</style>
