---
/*
  ServiceGallery.astro — single-container slideshow of candid
  "worker-phone" work photos for a service detail page.

  Per operator (2026-08-06 update, replacing the previous
  horizontal-scroll carousel implementation):
    "Make the gallery like a single container that goes with the
     website aesthetic doing a slideshow through the images."

  Behavior:
    - Single image visible at a time, fills the container.
    - Auto-advances every `interval` ms while the section is visible
      and the visitor hasn't interacted; pauses on hover/focus
      and when the tab is hidden (Page Visibility API).
    - Manual prev/next buttons (chevrons) on the sides, plus clickable
      dot indicators below.
    - Keyboard arrow keys navigate when the container has focus.
    - Reduced-motion users (`prefers-reduced-motion: reduce`) get
      manual-only navigation, no auto-advance.
    - The "view full-size" link under the image opens the current
      slide in a new tab so visitors can still see the photo at
      its native resolution.

  Inputs:
    photos: Array<{ id: string; src: string; alt: string }>
      - id: asset ID matching IMAGE_PROMPTS.md
      - src: path to webp (or svg, though webp is the active format)
      - alt: alt text from IMAGE_PROMPTS.md
    serviceSlug: short kebab-case slug used for ids and labels
    interval: ms between auto-advance slides (default 6000)

  Aesthetic match (per the rest of laredofencing.com):
    - Section: border-y border-slate-200 bg-slate-50 (same as before)
    - Image frame: rounded-2xl, slate-200 frame, slate-950/80 amber-300
      counter pill in the top-left (matches the previous carousel's
      counter to keep the visual language consistent).
    - Buttons: h-11 w-11 rounded-full border border-slate-300 bg-white
      (same chevron buttons as before, but standalone now since the
      rail is gone).
    - Hover: border-teal-500 / text-teal-700 teal hover state (matches
      the existing site's accent color).
    - Active dot: teal-700 (matches site accent).
    - Inactive dot: slate-300 (low-key, doesn't compete with photo).

  Realism style notes (memory 2026-07-31, anti-AI-image push 2026-08-06):
    Worker phone aesthetic — gloved hand visible, off-angle, slightly
    overexposed sunny day, real mess in frame. NOT aspirational, NOT
    studio-lit, NOT stock-photo perfect. The gallery is a credibility
    signal; AI-defaulted / studio-perfect / symmetric compositions
    would defeat that signal.

  Note: 2026-08-06 — gallery counts vary by service (4 for chain-link,
  5 for the other three) because some generated images didn't make
  the cut. The slideshow handles N=1 (no controls) through N=many
  gracefully.
*/

interface Photo {
  id: string;
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
  serviceSlug: string;
  interval?: number;
}

const { photos, serviceSlug, interval = 6000 } = Astro.props;
const containerId = `gallery-${serviceSlug}`;
const safeInterval = Math.max(2000, Math.min(interval, 30000));
---

<section
  aria-label={`${serviceSlug} work gallery`}
  class="border-y border-slate-200 bg-slate-50 py-12 sm:py-16"
>
  <div class="container-shell">
    <!-- Header removed per operator 2026-08-06: the slideshow speaks
         for itself. The previous 'Recent work / A few of the jobs
         we've finished / Cell-phone photos from the field' eyebrow,
         heading, and paragraph added noise without adding credibility
         (the photos themselves carry that signal). The counter pill
         on the active slide, the dot row below, and the photo count
         (e.g. '5 photos') give visitors enough metadata to orient.

         To free up the entire row for the prev/next chevrons (which
         previously were stranded against a column of text on
         desktop only), the header-right controls are now the only
         header content; the dots + counter below carry the position
         info instead. -->

    <!-- Controls removed per operator 2026-08-06:

         - Header prev/next chevrons stripped (the visible left/right
           arrows were off-brand for the gallery reading; the dots
           below already serve as direct-pick navigation).
         - Dot row stays as the only manual navigation affordance.
         - Hover-to-pause removed from the script (see below); the
           slideshow just auto-advances once a slide is shown and
           visitors can click a dot to jump if they don't want to
           wait.
         - Caption paragraph (count + 'auto-advancing, hover to pause'
           + 'arrows or dots to navigate' + 'click to view full-size')
           stripped. The 'click to view full-size' affordance still
           exists by virtue of the image being a link; visitors don't
           need a textual reminder.

         Aesthetic note: with the chevrons gone the section is now
         center-aligned from the dots up, which matches the operator's
         requested 'center the slideshow' reading. -->
    {photos.length > 0 && (
      <div
        id={containerId}
        class="gallery-slideshow"
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label={`${serviceSlug} work gallery`}
        aria-live={photos.length > 1 ? "off" : "polite"}
        data-gallery-interval={safeInterval}
      >
        <div class="gallery-stage relative overflow-hidden rounded-2xl bg-slate-200 shadow-sm" data-gallery-stage>
          {photos.map((photo, idx) => (
            <a
              href={photo.src}
              target="_blank"
              rel="noopener"
              class={[
                "gallery-slide absolute inset-0 block",
                idx === 0 ? "is-active" : "",
              ].filter(Boolean).join(" ")}
              data-slide-index={idx}
              data-gallery-slide
              aria-hidden={idx === 0 ? "false" : "true"}
              aria-label={`Open ${photo.alt} in a new tab`}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                width="800"
                height="1067"
                loading={idx === 0 ? "eager" : "lazy"}
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <span
                class="pointer-events-none absolute left-3 top-3 rounded-full bg-slate-950/80 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.12em] text-amber-300 backdrop-blur"
                aria-hidden="true"
              >
                <span data-gallery-counter-current>{String(idx + 1).padStart(2, "0")}</span>
                <span class="text-slate-300"> / </span>
                <span>{String(photos.length).padStart(2, "0")}</span>
              </span>
            </a>
          ))}
        </div>

        {photos.length > 1 && (
          <div class="mt-5 flex items-center justify-center" aria-label="Gallery position">
            <div class="flex items-center gap-2" role="tablist">
              {photos.map((photo, idx) => {
                const isActive = idx === 0;
                const dotClass = isActive
                  ? "h-2.5 rounded-full transition-all duration-300 bg-slate-950 w-6"
                  : "h-2.5 rounded-full transition-all duration-300 bg-slate-300 hover:bg-slate-500 w-2.5";
                return (
                  <button
                    type="button"
                    data-gallery-dot={containerId}
                    data-slide-index={idx}
                    class={dotClass}
                    role="tab"
                    aria-selected={idx === 0 ? "true" : "false"}
                    aria-label={`Show ${photo.alt}`}
                  />
                );
              })}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  /* Slideshow stack: every slide is positioned absolutely so we can
     crossfade between them with opacity rather than scroll. We avoid
     layout shift by setting aspect-ratio on the stage below. */
  .gallery-slideshow:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 4px;
    border-radius: 1rem;
  }

  .gallery-stage {
    aspect-ratio: 3 / 4;
    max-height: min(80vh, 720px);
  }
  @media (min-width: 768px) {
    .gallery-stage {
      aspect-ratio: 4 / 3;
      max-height: min(70vh, 640px);
    }
  }

  .gallery-slide {
    opacity: 0;
    transition: opacity 700ms ease-in-out;
    pointer-events: none;
  }
  .gallery-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  /* Pause the slideshow animation when the section is hovered or
     when any element within it has keyboard focus. The slideshow
     script reads [data-paused] off the container and clears the
     interval while it's set. */
  .gallery-slideshow:hover [data-pause-on-hover],
  .gallery-slideshow:focus-within [data-pause-on-hover] {
    /* marker selector; the JS uses getAttribute */ /* */
  }

  /* Reduced-motion users skip the crossfade transition entirely. */
  @media (prefers-reduced-motion: reduce) {
    .gallery-slide {
      transition: none;
    }
  }
</style>

<script>
  // Slideshow runtime.
  //
  // Each .gallery-slideshow has:
  //   - 1 stage with N [data-gallery-slide] <a> children, only one .is-active
  //   - 1 prev/next chevron pair (data-gallery-prev / data-gallery-next)
  //     which may be header-positioned (desktop) or footer-positioned (mobile)
  //   - N dots (data-gallery-dot) reflecting position; the dot whose index
  //     matches the active slide is dark, the rest are light slate
  //   - a counter inside each slide's top-left pill showing "XX / NN"
  //
  // Auto-advance:
  //   - Set on .gallery-slideshow via [data-gallery-interval] attribute
  //     (default in the component is 6000 ms).
  //   - Advances every interval ms; reset whenever the user interacts.
  //   - Pauses on hover/focus-within and when document.hidden.
  //   - Honors prefers-reduced-motion: never auto-advances if user
  //     requested reduced motion.
  //
  // Slideshows with 0 photos: nothing rendered (early return in the
  // Astro template).
  // Slideshows with 1 photo: no controls, no auto-advance, just the
  // single slide displayed.

  type Slideshow = {
    root: HTMLElement;
    stage: HTMLElement;
    slides: HTMLElement[];
    dots: HTMLElement[];
    counterEls: HTMLElement[];
    intervalMs: number;
    timer: number | null;
  };

  function initSlideshow(root: HTMLElement): Slideshow | null {
    const stage = root.querySelector<HTMLElement>("[data-gallery-stage]");
    if (!stage) return null;
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    if (slides.length === 0) return null;

    const slideshowId = root.id;
    const dots = slideshowId
      ? Array.from(document.querySelectorAll<HTMLElement>(`[data-gallery-dot="${slideshowId}"]`))
      : [];
    // Each slide carries the counter pill with [data-gallery-counter-current]
    // — we keep one element reference per slide so we don't write to a
    // single shared element (the active slide's pill is what shows in the
    // top-left; the others are display:none via opacity:0 but still in DOM).
    const counterEls = Array.from(
      root.querySelectorAll<HTMLElement>("[data-gallery-counter-current]")
    );

    const intervalAttr = parseInt(root.dataset.galleryInterval ?? "6000", 10);
    const intervalMs = isNaN(intervalAttr) ? 6000 : Math.max(2000, Math.min(intervalAttr, 30000));

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const ss: Slideshow = {
      root,
      stage,
      slides,
      dots,
      counterEls,
      intervalMs,
      timer: null,
    };

    function show(i: number): void {
      const idx = ((i % slides.length) + slides.length) % slides.length;
      slides.forEach((slide, j) => {
        const isActive = j === idx;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
      dots.forEach((dot, j) => {
        const isActive = j === idx;
        dot.setAttribute("aria-selected", isActive ? "true" : "false");
        dot.classList.toggle("bg-slate-950", isActive);
        dot.classList.toggle("bg-slate-300", !isActive);
        dot.classList.toggle("w-6", isActive);
        dot.classList.toggle("w-2.5", !isActive);
      });
      counterEls.forEach((el, j) => {
        if (j === idx) {
          el.textContent = String(idx + 1).padStart(2, "0");
        }
      });
      ss.root.dataset.galleryActiveIndex = String(idx);
    }

    function next(): void {
      const current = parseInt(ss.root.dataset.galleryActiveIndex ?? "0", 10);
      show(current + 1);
    }

    function startTimer(): void {
      if (slides.length < 2) return;
      if (reducedMotion) return;
      stopTimer();
      ss.timer = window.setInterval(() => {
        if (!document.hidden) {
          next();
        }
      }, ss.intervalMs);
    }
    function stopTimer(): void {
      if (ss.timer !== null) {
        window.clearInterval(ss.timer);
        ss.timer = null;
      }
    }
    function resetTimer(): void {
      // Reset the interval clock after a manual dot click so the
      // visitor gets a full `intervalMs` viewing time of the
      // newly-selected slide before auto-advance kicks in again.
      stopTimer();
      startTimer();
    }

    function onDotClick(this: HTMLElement): void {
      const idx = parseInt(this.dataset.slideIndex ?? "0", 10);
      show(idx);
      resetTimer();
    }

    function onVisibility(): void {
      // Page Visibility API - pause when the tab is hidden. Keeps
      // visitors who background the tab from coming back to a slideshow
      // that's looped dozens of times while they were away. Note: this
      // is the ONLY pause behavior left in the script - hover, focus,
      // and any other interaction do not pause per the 2026-08-06
      // operator decision. The slideshow just auto-advances.
      if (document.hidden) stopTimer();
      else startTimer();
    }

    // Wire up controls. With the chevron buttons removed
    // (operator 2026-08-06), only the dot row has manual navigation
    // affordances. Keyboard arrow keys were also removed since
    // there's no longer a visible button row establishing that
    // mental model.
    dots.forEach((dot) => dot.addEventListener("click", onDotClick));

    document.addEventListener("visibilitychange", onVisibility);

    // Initialize to the first slide and start the timer.
    root.dataset.galleryActiveIndex = "0";
    show(0);
    if (slides.length > 1 && !reducedMotion) startTimer();

    return ss;
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>(".gallery-slideshow").forEach((root) => {
      if (root.dataset.galleryInit === "1") return;
      root.dataset.galleryInit = "1";
      initSlideshow(root);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }

  // Re-init on Astro view transitions (for the back/forward cache).
  document.addEventListener("astro:page-load", () => {
    initAll();
  });
</script>